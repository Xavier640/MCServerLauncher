<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MCServerLauncher.ViewModels"
        xmlns:models="using:MCServerLauncher.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="MCServerLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MC Server Launcher"
        Width="900"
        Height="600"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="MC Server Launcher"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Button Content="New Server"
                Name="NewServerButton"
                Padding="16,8"
            HorizontalAlignment="Right"/>
        </DockPanel>

        <!-- Lista servere -->
        <Border Grid.Row="1"
                BorderBrush="#555"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8">
            <ListBox ItemsSource="{Binding Servers}"
                     SelectedItem="{Binding SelectedServer}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:MinecraftServer">
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="180"/>
                            <TextBlock Text="{Binding Version}" Opacity="0.7" Width="90"/>
                            <TextBlock Text="{Binding Type}" Opacity="0.7" Width="90"/>
                            <TextBlock Text="{Binding Status}" Opacity="0.7"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Butoane -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right">
                    <Button Content="Start" Name="StartButton" Padding="20,8"/>
                    <Button Content="Stop" Name="StopButton" Padding="20,8"/>
                    <Button Content="Open Folder" Name="OpenFolderButton" Padding="16,8"/>
                    <Button Content="Settings" Name="SettingsButton" Padding="16,8"/>
        </StackPanel>

    </Grid>
</Window>